{
  "expo": {
    "name": "VetSync",
    "slug": "vetsync",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "userInterfaceStyle": "light",
    "scheme": "vetsync",
    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#1A5276"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vetsync.app",
      "infoPlist": {
        "NSCalendarsUsageDescription": "Precisamos acessar seu calendário para adicionar os eventos de saúde do seu pet.",
        "NSRemindersUsageDescription": "Precisamos acessar seus lembretes para agendar notificações dos eventos."
      }
    },
    "android": {
      "versionCode": 1,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo.png",
        "backgroundColor": "#1A5276"
      },
      "package": "com.vetsync.app",
      "permissions": [
        "READ_CALENDAR",
        "WRITE_CALENDAR",
        "SCHEDULE_EXACT_ALARM",
        "POST_NOTIFICATIONS",
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-calendar",
        {
          "calendarPermission": "Precisamos acessar seu calendário para adicionar os eventos de saúde do seu pet."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/logo.png",
          "color": "#22a06b"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "214b44b5-9a00-4d9f-8928-7928046899aa"
      }
    }
  }
}
