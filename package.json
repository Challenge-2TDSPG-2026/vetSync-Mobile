{
  "name": "VetSync",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build": "expo export -p web",
    "validate:commit-hash": "node scripts/validate-commit-hash.js",
    "test": "jest --runInBand",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write eslint.config.js .prettierrc.json",
    "format:check": "prettier --check eslint.config.js .prettierrc.json",
    "check": "npm run typecheck && npm run lint && npm run format:check"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.16",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-navigation/bottom-tabs": "^7.19.1",
    "@react-navigation/elements": "^2.9.42",
    "@react-navigation/native": "^7.4.1",
    "@tanstack/react-query": "^5.90.5",
    "@vercel/analytics": "^2.0.1",
    "expo": "~57.0.26",
    "expo-asset": "~57.0.18",
    "expo-blob": "^57.0.2",
    "expo-calendar": "~57.0.5",
    "expo-camera": "~57.0.6",
    "expo-constants": "~57.0.19",
    "expo-file-system": "~57.0.7",
    "expo-image-manipulator": "~57.0.20",
    "expo-image-picker": "~57.0.20",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.11",
    "expo-local-authentication": "~57.0.3",
    "expo-notifications": "~57.0.21",
    "expo-print": "~57.0.2",
    "expo-router": "~57.0.24",
    "expo-screen-capture": "~57.0.3",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.22",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-qrcode-svg": "^6.3.24",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.10.1",
    "semver": "^7.7.4"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.4",
    "babel-preset-expo": "~57.0.0",
    "eslint": "^9.38.0",
    "eslint-config-expo": "~57.0.2",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "<rootDir>/jest.setup.ts"
    ],
    "moduleNameMapper": {
      "^expo-modules-core$": "<rootDir>/node_modules/expo/node_modules/expo-modules-core",
      "^expo-modules-core/(.*)$": "<rootDir>/node_modules/expo/node_modules/expo-modules-core/$1"
    },
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/dist/"
    ]
  },
  "overrides": {
    "uuid": "11.1.1"
  },
  "private": true
}
