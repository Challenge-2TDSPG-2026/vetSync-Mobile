# URL pública da API Java usada pelo build Expo/Vercel. Não coloque segredos neste arquivo.
EXPO_PUBLIC_API_BASE_URL=https://vetsync-java.onrender.com
# Opcional: SHA completo (40 caracteres) do commit. Se vazio, o app.config.js usa o commit do EAS/Vercel/CI ou o git local.
EXPO_PUBLIC_COMMIT_HASH=
# Opcional: número do build exibido na web/Expo Go. Se vazio, usa GITHUB_RUN_NUMBER no CI ou "local".
EXPO_PUBLIC_BUILD_NUMBER=
# Login com Google. Client IDs OAuth são públicos; NUNCA coloque o client secret aqui (o app não usa).
# Web: cliente "Aplicativo da Web" do Google Cloud (a URL do site precisa estar nas origens e redirecionamentos autorizados).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# Android: cliente "Android" (pacote com.vetsync.app + SHA-1 do certificado que assina o app). Vazio = botão oculto no Android.
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
# iOS: cliente "iOS" (Bundle ID com.vetsync.app). Vazio = botão oculto no iOS.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
